---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import dinoMercs from '../assets/dino-mercs.jpg';
import villageApp from '../assets/village-app.jpg';
import wildflower from '../assets/wildflower.jpg';
import bourbon from '../assets/bourbon.jpg';
import quiz from '../assets/quiz.jpg';
import gamingSite from '../assets/gaming-site.jpg';

// Placeholder copy until the real project write-ups exist.
const projects = [
    { title: "Dino Mercs", discipline: "Game", summary: "Project summary to come.", image: dinoMercs },
    { title: "Village Manager", discipline: "App", summary: "Project summary to come.", image: villageApp },
    { title: "Wildflower", discipline: "Web", summary: "Project summary to come.", image: wildflower },
    { title: "Bourbon", discipline: "Web", summary: "Project summary to come.", image: bourbon },
    { title: "Quiz", discipline: "Web", summary: "Project summary to come.", image: quiz },
    { title: "Gaming Site", discipline: "Web", summary: "Project summary to come.", image: gamingSite },
];

const colorSchemes = ["light", "dark"];
const labelClass = "text-xs font-semibold uppercase tracking-wide";
---

<Layout>
    <section class="flex min-h-svh flex-col px-4 pb-6 sm:px-6">
        <header class:list={["grid grid-cols-12 gap-x-4 gap-y-1 border-b border-ink py-3 sm:gap-x-6", labelClass]}>
            <span class="col-span-6 sm:col-span-3">A Studio</span>
            <span class="order-last col-span-12 sm:order-none sm:col-span-5 sm:col-start-5">
                Video Games / Web Applications / Cross-Platform Apps
            </span>
            <div role="group" aria-label="Color scheme" class="col-span-6 flex items-start justify-end gap-1 sm:col-span-3 sm:col-start-10">
                {colorSchemes.map((scheme, i) => (
                    <>
                        {i > 0 && <span aria-hidden="true">/</span>}
                        <button
                            type="button"
                            data-scheme={scheme}
                            aria-pressed="false"
                            class="uppercase opacity-60 transition-opacity hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:underline aria-pressed:decoration-accent aria-pressed:decoration-2 aria-pressed:underline-offset-4 aria-pressed:opacity-100"
                        >
                            {scheme}
                        </button>
                    </>
                ))}
            </div>
        </header>

        <h1 class="my-auto grid grid-cols-12 gap-x-4 py-12 font-display text-[12.5vw] leading-[0.82] sm:gap-x-6">
            <span class="col-span-12">Unusual</span>
            <span class="col-span-11 col-start-2 whitespace-nowrap sm:col-span-10 sm:col-start-3">Undertaking<span class="text-accent">.</span></span>
        </h1>

        <div class="grid grid-cols-12 gap-x-4 gap-y-4 border-t border-ink pt-3 sm:gap-x-6">
            <p class="col-span-12 text-lg leading-snug sm:col-span-6 lg:col-span-5">
                Blending art + design + engineering to create digital things that people love.
            </p>
            <a
                href="#work"
                class:list={["col-span-12 self-end transition-colors hover:text-accent sm:col-span-3 sm:col-start-10 sm:text-right", labelClass]}
            >
                Selected work ↓
            </a>
        </div>
    </section>

    <section id="work" class="px-4 py-20 sm:px-6">
        <div class="grid grid-cols-12 items-end gap-x-4 border-b border-ink pb-3 sm:gap-x-6">
            <h2 class="col-span-9 font-display text-5xl leading-none sm:text-7xl">Selected work</h2>
            <span class:list={["col-span-3 text-right", labelClass]}>({projects.length})</span>
        </div>

        <ol class="mt-8 grid grid-cols-12 gap-x-4 gap-y-14 sm:gap-x-6">
            {projects.map((project, i) => (
                <li class="col-span-12 sm:col-span-6 lg:col-span-4">
                    <Image
                        src={project.image}
                        alt={`Screenshot of ${project.title}`}
                        widths={[480, 800, 1200]}
                        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                        class="aspect-[4/3] w-full object-cover"
                    />
                    <div class="mt-3 grid grid-cols-[2.5rem_1fr_auto] gap-x-2 border-t border-ink pt-2">
                        <span class="text-sm font-semibold">{String(i + 1).padStart(2, "0")}</span>
                        <h3 class="text-sm font-semibold">{project.title}</h3>
                        <span class={labelClass}>{project.discipline}</span>
                        <p class="col-span-2 col-start-2 mt-1 text-sm opacity-70">{project.summary}</p>
                    </div>
                </li>
            ))}
        </ol>
    </section>

    <footer class="px-4 pb-6 sm:px-6">
        <div class="grid grid-cols-12 gap-x-4 gap-y-4 border-t border-ink pt-3 sm:gap-x-6">
            <p class:list={["col-span-12 sm:col-span-3", labelClass]}>Contact</p>
            <div class="col-span-12 sm:col-span-9">
                <button
                    type="button"
                    id="copy-email-button"
                    class="inline-grid text-left font-display text-[7.5vw] leading-none sm:whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:text-[4vw]"
                    aria-label="Copy email address"
                >
                    <span
                        id="copy-email-default"
                        class="col-start-1 row-start-1 underline decoration-accent decoration-[0.06em] underline-offset-[0.15em] transition-all duration-300 ease-out"
                    >
                        email (at) unusualundertaking.com
                    </span>
                    <span
                        id="copy-email-feedback"
                        class="pointer-events-none col-start-1 row-start-1 translate-y-1 whitespace-nowrap opacity-0 transition-all duration-300 ease-out"
                        aria-live="polite"
                    >
                        Copied<span class="text-accent">.</span>
                    </span>
                </button>
                <p class:list={["mt-3", labelClass]}>Click to copy</p>
            </div>
        </div>
        <div class:list={["mt-24 flex justify-between", labelClass]}>
            <span>© {new Date().getFullYear()} Unusual Undertaking</span>
            <a href="#" class="transition-colors hover:text-accent">Top ↑</a>
        </div>
    </footer>

    <script is:inline>
    const root = document.documentElement;
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
    const schemeButtons = Array.from(document.querySelectorAll("[data-scheme]"));

    const systemScheme = () => (systemDark.matches ? "dark" : "light");
    const syncSchemeButtons = () => {
        const activeScheme = root.dataset.theme ?? systemScheme();
        for (const button of schemeButtons) {
            button.setAttribute("aria-pressed", String(button.dataset.scheme === activeScheme));
        }
    };

    for (const button of schemeButtons) {
        button.addEventListener("click", () => {
            const scheme = button.dataset.scheme;

            // Only remember a choice that differs from the system, so picking the
            // system's own scheme drops the override and follows the system again.
            try {
                if (scheme === systemScheme()) {
                    delete root.dataset.theme;
                    localStorage.removeItem("uu-color-scheme");
                } else {
                    root.dataset.theme = scheme;
                    localStorage.setItem("uu-color-scheme", scheme);
                }
            } catch {}

            syncSchemeButtons();
        });
    }

    systemDark.addEventListener("change", syncSchemeButtons);
    syncSchemeButtons();

    const copyEmailButton = document.getElementById("copy-email-button");
    const copyEmailDefault = document.getElementById("copy-email-default");
    const copyEmailFeedback = document.getElementById("copy-email-feedback");

    if (
        copyEmailButton instanceof HTMLButtonElement &&
        copyEmailDefault instanceof HTMLSpanElement &&
        copyEmailFeedback instanceof HTMLSpanElement
    ) {
        let resetCopyFeedbackTimeout = 0;

        copyEmailButton.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText("email@unusualundertaking.com");

                if (resetCopyFeedbackTimeout) {
                    window.clearTimeout(resetCopyFeedbackTimeout);
                }

                copyEmailDefault.classList.add("opacity-0", "-translate-y-1");
                copyEmailFeedback.classList.remove("opacity-0", "translate-y-1");
                copyEmailButton.disabled = true;
                copyEmailButton.setAttribute("aria-label", "Email address copied");

                resetCopyFeedbackTimeout = window.setTimeout(() => {
                    copyEmailFeedback.classList.add("opacity-0", "translate-y-1");
                    copyEmailDefault.classList.remove("opacity-0", "-translate-y-1");
                    copyEmailButton.disabled = false;
                    copyEmailButton.setAttribute("aria-label", "Copy email address");
                    resetCopyFeedbackTimeout = 0;
                }, 3000);
            } catch {
                copyEmailButton.setAttribute("aria-label", "Unable to copy email address");
            }
        });
    }
    </script>
</Layout>
